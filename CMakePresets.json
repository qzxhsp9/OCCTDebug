{
  "version": 3,
  "configurePresets": [
    {
      "hidden": true,
      "name": "qt-env",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}"
      }
    },
    {
      "name": "OCCTDebug-Debug",
      "displayName": "OCCTDebug Debug",
      "description": "Windows x64 Debug build. Qt is resolved from QTDIR, src/QtWorkbenchDefaults.cmake, or CMake cache.",
      "inherits": "qt-env",
      "binaryDir": "${sourceDir}/out/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "OCCTDebug-Debug",
      "configurePreset": "OCCTDebug-Debug",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "OCCTDebug-Debug",
      "configurePreset": "OCCTDebug-Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
